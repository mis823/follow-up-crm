# Follow-Up CRM Server Configuration
PORT=3000

# =========================================================================
# OPTION 1: 100% FREE ZERO-CLOUD CONNECTOR (RECOMMENDED - NO GOOGLE CLOUD)
# =========================================================================
# 1. Open your Google Sheet > Extensions > Apps Script
# 2. Paste code from google-apps-script/Code.gs and click Save
# 3. Click Deploy > New deployment > Web app > Execute as "Me", Access "Anyone"
# 4. Paste the Web App URL here:
APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec"

# =========================================================================
# OPTION 2: GOOGLE CLOUD SERVICE ACCOUNT (OPTIONAL)
# =========================================================================
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
GOOGLE_PRIVATE_KEY="YOUR_PRIVATE_KEY"

# Sheet Names (optional, default: Master and Responses1)
MASTER_SHEET_NAME=Master
RESPONSES_SHEET_NAME=Responses1

# Master Sheet starting data row (default: 7)
MASTER_START_ROW=7

# Cache Refresh Interval in minutes (default: 10)
MASTER_CACHE_TTL_MINUTES=10
